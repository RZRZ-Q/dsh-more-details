{
  "name": "dsh-more-details",
  "version": "0.3.13",
  "description": "Select text for an independent DeepSeek web discussion, then bring it back to DSH with reference cards and on-demand text snapshots.",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "side-chat",
    "dsh-plugin"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RZRZ-Q/dsh-more-details.git"
  },
  "homepage": "https://github.com/RZRZ-Q/dsh-more-details",
  "bugs": {
    "url": "https://github.com/RZRZ-Q/dsh-more-details/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./remote": {
      "types": "./lib/remote.d.ts",
      "default": "./lib/remote.js"
    },
    "./typert": {
      "types": "./lib/typert.d.ts",
      "default": "./lib/typert.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "UPSTREAM.md",
    "THIRD_PARTY_NOTICES.md",
    "docs/open-source/validation.md",
    "docs/open-source/compatibility.md",
    "docs/open-source/comparison.md",
    "docs/open-source/release-notes.md",
    "docs/open-source/distribution.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-input-trigger",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-model-selection",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-locale"
      ]
    },
    "compatibility": {
      "dsh": "0.2.0-rc.2 || 0.2.1-alpha.4",
      "dshReleases": {
        "0.2.0-rc.2": "compatible",
        "0.2.1-alpha.4": "compatible"
      }
    }
  },
  "dshCompatibility": {
    "testedVersions": [
      "0.2.0-rc.2",
      "0.2.1-alpha.4"
    ]
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": "0.2.0-rc.2 || 0.2.1-alpha.4"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src test scripts tsdown.config.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "build": "npm run clean && tsc -p tsconfig.build.json && tsdown --config tsdown.config.ts",
    "pack:verify": "npm run build && node scripts/verify-package.mjs",
    "clean-profile:verify": "npm run build && node scripts/clean-profile-e2e.mjs",
    "dsh:update": "node scripts/update-dsh-compatibility.mjs",
    "identity:install": "node scripts/public-identity.mjs install",
    "identity:check": "node scripts/public-identity.mjs check",
    "identity:test": "node --test scripts/public-identity.test.mjs",
    "release:publish": "node scripts/public-identity.mjs release",
    "check": "npm run identity:test && pnpm peers check && npm run typecheck && npm run lint && npm run test && npm run pack:verify",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4 || ~4.0.5-alpha.2",
    "@deepseek-ai/dsh-api-remotes": "0.2.0-rc.2 || 0.2.1-alpha.4",
    "@deepseek-ai/dsh-api-session-controller": "0.2.0-rc.2 || 0.2.1-alpha.4",
    "@deepseek-ai/dsh-client-ui-chat": "0.2.0-rc.2 || 0.2.1-alpha.4",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.0-rc.2 || 0.2.1-alpha.4",
    "@deepseek-ai/dsh-client-ui-input-trigger": "0.2.0-rc.2 || 0.2.1-alpha.4",
    "@deepseek-ai/dsh-client-ui-layout": "0.2.0-rc.2 || 0.2.1-alpha.4",
    "@deepseek-ai/dsh-client-ui-model-selection": "0.2.0-rc.2 || 0.2.1-alpha.4",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.0-rc.2 || 0.2.1-alpha.4",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.0-rc.2 || 0.2.1-alpha.4",
    "@deepseek-ai/dsh-client-ui-workspace": "0.2.0-rc.2 || 0.2.1-alpha.4",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2 || 0.2.1-alpha.4",
    "@deepseek-ai/dsh-session": "0.2.0-rc.2 || 0.2.1-alpha.4",
    "@deepseek-ai/dsh-session-query": "0.2.0-rc.2 || 0.2.1-alpha.4",
    "@deepseek-ai/dsh-typert-protocol": "0.2.0-rc.2 || 0.2.1-alpha.4",
    "react": ">=18.2.0 <20.0.0",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.0-rc.2 || 0.2.1-alpha.4",
    "@deepseek-ai/schemastery": "~3.18.4 || ~3.18.5-alpha.2",
    "@deepseek-ai/dsh-api-workspace-controller": "0.2.0-rc.2 || 0.2.1-alpha.4",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.2.0-rc.2 || 0.2.1-alpha.4",
    "@deepseek-ai/dsh-credentials": "0.2.0-rc.2 || 0.2.1-alpha.4",
    "@deepseek-ai/dsh-attachment": "0.2.0-rc.2 || 0.2.1-alpha.4",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2 || 0.2.1-alpha.4",
    "@deepseek-ai/dsh-client-locale": "0.2.0-rc.2 || 0.2.1-alpha.4"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5-alpha.2",
    "@deepseek-ai/dsh-agent": "0.2.1-alpha.4",
    "@deepseek-ai/dsh-agent-preset-registry": "0.2.1-alpha.4",
    "@deepseek-ai/dsh-api-remotes": "0.2.1-alpha.4",
    "@deepseek-ai/dsh-api-session-controller": "0.2.1-alpha.4",
    "@deepseek-ai/dsh-attachment": "0.2.1-alpha.4",
    "@deepseek-ai/dsh-client-store": "0.2.1-alpha.4",
    "@deepseek-ai/dsh-client-ui-chat": "0.2.1-alpha.4",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.1-alpha.4",
    "@deepseek-ai/dsh-client-ui-input-trigger": "0.2.1-alpha.4",
    "@deepseek-ai/dsh-client-ui-layout": "0.2.1-alpha.4",
    "@deepseek-ai/dsh-client-ui-model-selection": "0.2.1-alpha.4",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.1-alpha.4",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-alpha.4",
    "@deepseek-ai/dsh-client-ui-session": "0.2.1-alpha.4",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-alpha.4",
    "@deepseek-ai/dsh-client-ui-theme": "0.2.1-alpha.4",
    "@deepseek-ai/dsh-client-ui-workspace": "0.2.1-alpha.4",
    "@deepseek-ai/dsh-compaction": "0.2.1-alpha.4",
    "@deepseek-ai/dsh-jobs": "0.2.1-alpha.4",
    "@deepseek-ai/dsh-llm": "0.2.1-alpha.4",
    "@deepseek-ai/dsh-output-retention": "0.2.1-alpha.4",
    "@deepseek-ai/dsh-sandbox": "0.2.1-alpha.4",
    "@deepseek-ai/dsh-session": "0.2.1-alpha.4",
    "@deepseek-ai/dsh-session-persistence": "0.2.1-alpha.4",
    "@deepseek-ai/dsh-session-query": "0.2.1-alpha.4",
    "@deepseek-ai/dsh-settings": "0.2.1-alpha.4",
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-alpha.4",
    "@deepseek-ai/dsh-user-questions": "0.2.1-alpha.4",
    "@deepseek-ai/dsh-util-code-language": "0.2.1-alpha.4",
    "@deepseek-ai/dsh-util-workspace-path": "0.2.1-alpha.4",
    "@deepseek-ai/dsh-workspace": "0.2.1-alpha.4",
    "@shikijs/langs": "4.3.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "22.20.0",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "@vitest/coverage-v8": "4.1.8",
    "anser": "2.3.5",
